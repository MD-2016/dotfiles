{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/home/md/.spotify_covers/Softly__As_In_A_Morning_Sunrise___George_Benson_jpg",
    "width": 20,
    "height": 8,
    "position": "top"
  },
  "modules": [
    {
      "type": "media",
      "player": "spotify",
      "format": "{1} - {3}"
    },
    "break",
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "font",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "disk",
    {
      "type": "command",
      "key": "OS Age",
      "text": "/home/md/.config/fastfetch/oslife.sh"
      "shell": "/usr/bin/bash",
      "keyColor": "red"
    },
    {
      "type": "command",
      "key": "Time Remaining",
      "text": "/home/md/.config/fastfetch/ossenddate.sh",
      "keyColor": "red"
    }
  ],
}

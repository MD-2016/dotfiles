[
  {
    "backlight": {
      "format": "{icon} {percent}%",
      "format-icons": [
        "󰃞",
        "󰃟",
        "󰃠"
      ]
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-alt": "{icon} {time}",
      "format-charging": "󰂄 {capacity}%",
      "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "format-plugged": "󰚥 {capacity}%",
      "states": {
        "critical": 15,
        "warning": 30
      }
    },
    "clock": {
      "format": "󰥔 {:%H:%M   %d %b}",
      "format-alt": "󰥔 {:%Y-%m-%d}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
      "format": "󰻠 {usage}%",
      "interval": 2,
      "tooltip": false
    },
    "custom/power": {
      "format": "󰐥",
      "on-click": "wlogout",
      "tooltip": false
    },
    "height": 36,
    "hyprland/window": {
      "format": "{}",
      "max-length": 35,
      "separate-outputs": true
    },
    "hyprland/workspaces": {
      "all-outputs": true,
      "disable-scroll": true,
      "format": "{icon}",
      "format-icons": {
        "1": "",
        "2": "󰖟",
        "3": "󰓓",
        "4": "󰉋",
        "5": "󰎆",
        "default": "",
        "focused": "",
        "urgent": ""
      }
    },
    "layer": "top",
    "margin-left": 10,
    "margin-right": 10,
    "margin-top": 6,
    "memory": {
      "format": "󰍛 {}%",
      "interval": 5
    },
    "modules-center": [
      "clock"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-right": [
      "cpu",
      "memory",
      "temperature",
      "pulseaudio",
      "backlight",
      "network",
      "battery",
      "custom/power"
    ],
    "network": {
      "format-disconnected": "󰖪 Disconnected",
      "format-ethernet": "󰈀 Wired",
      "format-wifi": "󰖩 {essid}",
      "max-length": 20,
      "tooltip-format": "{ifname} via {gwaddr}"
    },
    "position": "top",
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-bluetooth": "{icon} {volume}%",
      "format-icons": {
        "car": "󰄋",
        "default": [
          "󰕿",
          "",
          "󰕾"
        ],
        "hands-free": "󣠰",
        "headphone": "󰋋",
        "headset": "󰋎",
        "phone": "󰏲",
        "portable": "󰏲"
      },
      "format-muted": "󰖁 Muted",
      "on-click": "pavucontrol"
    },
    "spacing": 4,
    "temperature": {
      "critical-threshold": 80,
      "format": "{icon} {temperatureC}°C",
      "format-icons": [
        "󰔏",
        "󰔏",
        "󰔏"
      ]
    }
  }
]
